+    /// 989snd's module init (fno 0): its random stream starts from the table in the module's own .data (rng.rs
+    /// `from_uya_irx`), read from the module image the EE loaded the IOP module from, which is still in EE RAM at this call.
+    /// Without it every draw is 0: a random wait never waits, and a looping ambience keys a voice every tick until the 48
+    /// voices are gone.
+    fn snd_rng_rc3(&mut self) {
+        use crate::snd989::{irx::{Irx, MODULE_989SND}, rng::Rng250};
+        let elf = Irx::find_in_blob(&self.mem.ram[..32 << 20], MODULE_989SND).ok_or_else(|| "989snd: the module image is not in EE RAM".to_string());
+        match elf.and_then(|e| Irx::parse(e)).and_then(|irx| Rng250::from_uya_irx(&irx)) {
+            Ok(rng) => self.snd.ensure(&self.iop, &self.mem.ram, true, 0).drv.core.rng = rng,
+            Err(e) => self.stop = Some(e),
+        }
+    }
+
