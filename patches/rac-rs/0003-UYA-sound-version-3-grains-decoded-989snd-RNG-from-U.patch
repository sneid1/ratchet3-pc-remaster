+    /// A version 3 grain {word, delay} as the model's version 1 grain. The operands are read where UYA's 989snd grain
+    /// handlers read them (table at module 0x1d638, called from 0x6240 with the grain's address): `b` = the word's low three
+    /// bytes as s8, `params` = the bank's parameter area (SBlk +0x34) the 24-bit operand points into.
+    pub fn from_v3(word: u32, delay: u32, meta: &[u8], params: usize) -> Result<Grain, String> {
+        let (kind, arg) = (word >> 24, (word & 0xff_ffff) as usize);
+        let b = word.to_le_bytes().map(|x| x as i8 as i16);
+        let delay = u16::try_from(delay).map_err(|_| format!("type {kind} delay {delay:#x} beyond 16 bits"))?;
+        let mut p = [0u8; 32];
+        let put = |p: &mut [u8; 32], o: usize, v: i16| p[o..o + 2].copy_from_slice(&v.to_le_bytes());
+        let kind = match kind {
+            // 0x4a2c, the handler of both: the 0x18-byte tone record at params + arg, version 1's tone operands.
+            1 | 9 => {
+                p[..0x18].copy_from_slice(span(meta, params + arg, 0x18)?);
+                GRAIN_TONE
+            }
+            // 0x4f34: the 16-byte LFO record at params + arg: version 1's operands except the start phase, +0xa (v1 +0x12).
+            4 => {
+                let l = span(meta, params + arg, 0x10)?;
+                p[..0x10].copy_from_slice(l);
+                p[0x12..0x14].copy_from_slice(&l[0xa..0xc]);
+                4
+            }
+            // 0x506c: the loop end of version 3 jumps back at most once per tick; a second jump in the same tick waits one
+            // tick (handler flag 0x40, cleared every tick). Marked in p0 for the model (`exec`, type 22).
+            22 => {
+                p[0] = 1;
+                22
+            }
+            // 0x5204 random block (N, L, last pick), 0x5560 random register (reg, low, high), 0x56d4 register test (reg, op,
+            // value), 0x5980 sequential block (N, L, state): version 1's p0 / p2 / p4.
+            25 | 31 | 34 | 39 => {
+                put(&mut p, 0, b[0]);
+                put(&mut p, 2, b[1]);
+                put(&mut p, 4, b[2]);
+                kind
+            }
+            // 0x5314 random wait: rand % (24-bit operand + 1). The model's operand is s16 (version 1).
+            26 => {
+                put(&mut p, 0, i16::try_from(arg).map_err(|_| format!("random wait {arg:#x} beyond the model's 16-bit operand"))?);
+                26
+            }
+            // 0x5360 random bend (s8 percent), 0x5428 bend, 0x54a0 add to bend, 0x55f4 / 0x5664 register inc / dec,
+            // 0x5798 marker id, 0x57a0 goto marker: one s8 operand, version 1's p0.
+            27 | 28 | 29 | 32 | 33 | 35 | 36 => {
+                put(&mut p, 0, b[0]);
+                kind
+            }
+            // 0x5524 set register: reg (s8), value (u8 at p2).
+            30 => {
+                put(&mut p, 0, b[0]);
+                p[2] = word.to_le_bytes()[1];
+                30
+            }
+            // 0x5848 random goto (low, high marker), 0x5a4c add to register (value, reg), 0x5b2c copy register (from, to):
+            // version 1's p0 / p2.
+            37 | 40 | 44 => {
+                put(&mut p, 0, b[0]);
+                put(&mut p, 2, b[1]);
+                kind
+            }
+            // No operands: 0x4a24 null, 0x4f24 / 0x4f2c cross references, 0x505c / 0x5064 control null / loop start, 0x511c
+            // loop continue, 0x51b8 stop, 0x5944 wait for voices, 0x5ab0 / 0x5ad4 key off / kill voices, 0x5b0c stop marker.
+            0 | 2 | 3 | 20 | 21 | 23 | 24 | 38 | 41 | 42 | 43 => kind,
+            _ => return Err(format!("version 3 grain type {kind} (operand {arg:#x}) is not decoded")),
+        };
+        Ok(Grain { kind, delay, p })
+    }
+
     /// The tone operands of a type-1 grain.
     pub fn tone(&self) -> Option<Tone> {
         if self.kind != GRAIN_TONE {
@@ -193,15 +265,24 @@ impl Bank {
         let signature = Signature::from_sblk(meta)?;
         let sound_table = u32le(meta, 0x1c)? as usize;
         if version == 3 {
-            // Version 3 (Up Your Arsenal): the header counts, the sound table offset (+0x1c) and its 12-byte entries are
-            // version 1's, but a grain is an 8-byte record (each sound's grain offset steps by 8 per grain; the grain area
-            // ends at the offset in +0x34, where a parameter area begins) whose layout the model does not decode yet. The
-            // bank loads with its sample data and every sound entry, without grains: the model voices none of them, so a
-            // play returns no handle (`playable`).
+            // Version 3 (Up Your Arsenal's 989snd): the header counts, the sound table (+0x1c) and its 12-byte entries are
+            // version 1's (+5 is the instance limit). A grain is an 8-byte record {u32 word, u32 delay} in the table at +0x20
+            // (a sound's grain offset steps by 8 per grain); the word's top byte is the type, its low 24 bits the operand:
+            // three signed bytes, or a byte offset into the parameter area at +0x34 (tones, LFOs). Each grain is translated
+            // to the version 1 operands the model reads (`Grain::from_v3`).
+            let grain_table = u32le(meta, 0x20)? as usize;
+            let params = u32le(meta, 0x34)? as usize;
             let mut sounds = Vec::with_capacity(signature.sounds as usize);
             for i in 0..signature.sounds as usize {
                 let e = span(meta, sound_table + i * SOUND_BYTES, SOUND_BYTES)?;
-                sounds.push(Sound { volume: e[0] as i8, group: e[1], pan: u16le(e, 2)?, pad5: e[5], flags: u16le(e, 6)?, grain_offset: u32le(e, 8)?, grains: Vec::new() });
+                let (count, grain_offset) = (e[4] as usize, u32le(e, 8)?);
+                let mut list = Vec::with_capacity(count);
+                for g in 0..count {
+                    let at = grain_table + grain_offset as usize + g * GRAIN3_BYTES;
+                    let grain = u32le(meta, at).and_then(|word| Grain::from_v3(word, u32le(meta, at + 4)?, meta, params));
+                    list.push(grain.map_err(|err| format!("sound {i} grain {g}: {err}"))?);
+                }
+                sounds.push(Sound { volume: e[0] as i8, group: e[1], pan: u16le(e, 2)?, pad5: e[5], flags: u16le(e, 6)?, grain_offset, grains: list });
             }
             return Ok(Bank { signature, sounds, data: data.to_vec() });
         }
