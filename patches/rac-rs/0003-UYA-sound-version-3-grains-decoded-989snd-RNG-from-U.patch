diff --git a/oracle/src/snd989/rng.rs b/oracle/src/snd989/rng.rs
index a463e85..f30ace2 100644
--- a/oracle/src/snd989/rng.rs
+++ b/oracle/src/snd989/rng.rs
@@ -9,6 +9,11 @@ use super::irx::Irx;
 pub const TABLE_ADDR: u32 = 0x18f44;
 pub const INDEX_ADDR: u32 = 0x18f40;
 pub const LEN: usize = 250;
+/// Up Your Arsenal's 989snd: rand (its first four code words), the u16 index and the table.
+pub const UYA_RAND: u32 = 0xbecc;
+pub const UYA_RAND_CODE: [u32; 4] = [0x3c07_0002, 0x00e0_4821, 0x84e6_d7e8, 0x94e8_d7e8];
+pub const UYA_INDEX_ADDR: u32 = 0x1d7e8;
+pub const UYA_TABLE_ADDR: u32 = 0x1d7ec;
 
 #[derive(Clone, Debug, PartialEq, Eq)]
 pub struct Rng250 {
@@ -31,6 +36,19 @@ impl Rng250 {
         Rng250::from_state(decode(raw), i)
     }
 
+    /// Initial state of Up Your Arsenal's 989snd (the version 3 driver): the same generator (rand at module 0xbecc), its
+    /// index a u16 at 0x1d7e8 and the table at 0x1d7ec of the module's .data. The rand code is checked first, so another
+    /// build of the module fails here instead of drawing from the wrong bytes.
+    pub fn from_uya_irx(irx: &Irx) -> Result<Rng250, String> {
+        let code: Vec<Option<u32>> = (0..4).map(|k| irx.u32_at(UYA_RAND + 4 * k)).collect();
+        if code != UYA_RAND_CODE.map(Some) {
+            return Err(format!("989snd: no R250 rand at {UYA_RAND:#x} ({code:x?})"));
+        }
+        let raw = irx.bytes(UYA_TABLE_ADDR, LEN * 2).ok_or("989snd: R250 table outside the module image")?;
+        let i = irx.u16_at(UYA_INDEX_ADDR).ok_or("989snd: R250 index outside the module image")? as usize;
+        Rng250::from_state(decode(raw), i)
+    }
+
     /// Continue exactly where a savestate's IOP RAM is: `base` = the module's load address
     /// (`Irx::find_base_in_ram`), table at base + 0x18f44, index word at base + 0x18f40.
