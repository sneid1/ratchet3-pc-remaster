+/// applied, CT24 / CT16 expanded with TEXA, alpha on the GS scale. None for a format that is no texture.
+pub fn rgba_for_draw(v: &[u8], tex0: u64, clamp: u64, texa: u64, texclut: u64) -> Option<(u32, u32, Vec<u8>)> {
+	let t = Tex::from_tex0(tex0);
+	if block_size(t.psm).0 == 0 || v.len() < crate::gsfull::gs_mem::VRAM_SIZE {
+		return None;
+	}
+	let region = Region::create(&t, clamp);
+	let ((rl, rt, _, _), w, h) = rect_of(&t, &region);
+	if w <= 0 || h <= 0 {
+		return None;
+	}
+	let clut = if has_palette(t.psm) { clut_entries(v, &t, texa, texclut) } else { None };
