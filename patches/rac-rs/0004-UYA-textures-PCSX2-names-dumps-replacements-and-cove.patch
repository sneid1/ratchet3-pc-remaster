diff --git a/rac-rs/src/engine/gsfull/gs/texhook.rs b/rac-rs/src/engine/gsfull/gs/texhook.rs
new file mode 100644
index 0000000..7e639aa
--- /dev/null
+++ b/rac-rs/src/engine/gsfull/gs/texhook.rs
@@ -0,0 +1,345 @@
+//! [PC] Texture packs on the GS-full pipe (`port/uya`; `texpack/live.rs`): every textured prim gets the PCSX2 name of the texture
+//! it samples, its replacement and its id for the coverage plane, all decided on the front end at draw time.
+//!
+//! Naming must not wait for the rasteriser, so the front end keeps its own copy of local memory (`shadow`): host -> local uploads
+//! are written into it as their data arrives and local -> local copies are repeated on it, in GIF order, which is the order the back
+//! end applies them in. What prims draw is not in the copy: the blocks of the frame buffer (and z buffer) page rows each prim's box
+//! touches are marked `dirty`, and a texture on a dirty block (a render target, like PCSX2's) is never named; an upload makes its
+//! blocks clean again, a copy passes dirtiness from source to destination. Dirtiness is kept per byte plane (`planes`): the low 24
+//! bits of each 32-bit word and its top byte, because UYA keeps T8H / T4HL / T4HH textures in the top byte of its CT24 display
+//! buffer and Z24 depth buffer, which drawing there never touches. Marking the whole scissor instead of the rows drawn would be too
+//! much too: UYA streams textures into the parts of its targets a frame's draws leave alone. Each block keeps the stamp of its last
+//! change (`ver`), so a name made earlier stays valid while no block of the texture or its CLUT has changed since (`Entry::built`).
+//!
+//! Per name the hook dumps the texture once (`texpack::live::Dumper`), looks the replacement up (`texpack::live::Live`; not for
+//! region repeat, CLAMP mode 3) and counts the prims drawn with it. With coverage on, every pixel write also stores the prim's
+//! texture id in a plane of one u32 per 2 bytes of local memory (`gs_raster::shade`); `Gs::cover_ids` reads the ids of the shown
+//! picture. A blended write takes a pixel only when it keeps less than half of what was there; a prim drawn from a render target
+//! (UYA draws its scene into one buffer and blits it to the shown one, and reads it back as T8 for colour effects) and a local copy
+//! pass on the ids of the pixels they read, so the shown picture names the textures the scene was drawn with.
+
+use super::super::crtc::Crtc;
+use super::super::gs_mem::{a16, a32, local_copy, luts, put, span, Trx, VRAM_SIZE};
+use super::super::gs_raster::Ctx;
+use super::Gs;
+use crate::texpack::gsname;
+use crate::texpack::live::{Dumper, Live, Repl};
+use crate::texpack::name::TexName;
+use std::collections::HashMap;
+use std::sync::Arc;
+
+/// Blocks of local memory (256 bytes each).
+const BLOCKS: usize = 16384;
+/// Texture id of a prim that samples a render target (a texture on blocks drawn into); its pixels take the ids of what they read.
+pub use super::super::gs_raster::TID_RT as RT;
+/// TEX0 bits a name depends on: TBP0, TBW, PSM, TW, TH and the CLUT fields; not TCC, TFX, CLD.
+const TEX0_MASK: u64 = ((1u64 << 34) - 1) | (((1u64 << 24) - 1) << 37);
+
+/// Byte planes of local memory a format writes or reads: bit 0 the low 24 bits of each 32-bit word, bit 1 its top byte. CT24 and
+/// Z24 leave the top byte alone; T8H, T4HL and T4HH live in it; everything else spans both.
+fn planes(psm: u32) -> u8 {
+    match psm {
+        0x01 | 0x31 => 1,
+        0x1b | 0x24 | 0x2c => 2,
+        _ => 3,
+    }
+}
+
+/// The planes a frame buffer write reaches, with FBMSK (a CT32 target whose top byte or colour bytes are all masked).
+fn fb_planes(fpsm: u32, fbmsk: u32) -> u8 {
+    let mut p = planes(fpsm);
+    if fpsm == 0 && fbmsk & 0xff00_0000 == 0xff00_0000 {
+        p &= !2;
+    }
+    if fpsm == 0 && fbmsk & 0xff_ffff == 0xff_ffff {
+        p &= !1;
+    }
+    p
+}
+
+/// What the hook does; at least one of the three.
+pub struct TexOpts {
+    pub dump: Option<Dumper>,
+    pub live: Option<Live>,
+    pub cover: bool,
+}
+
+/// One texture name the run has drawn (its id is its index + 1).
+pub struct Seen {
+    pub name: TexName,
+    pub stem: String,
+    pub psm: u32,
+    /// Size of the named rectangle in texels.
+    pub w: u32,
+    pub h: u32,
+    /// Prims drawn with it.
+    pub prims: u64,
+    /// The replacement drawn in its place, if any.
+    pub repl: Option<Arc<Repl>>,
+}
+
+type Key = (u64, u64, u64, u64);
+
+struct Entry {
+    built: u64,
+    span: (u32, u32),
+    cspan: (u32, u32),
+    tid: u32,
+    repl: usize,
+    rect: [u32; 4],
+}
+
+pub(super) struct TexHook {
+    shadow: Vec<u8>,
+    trx: Trx,
+    ver: Vec<u64>,
+    /// Drawn-into bits per block, plane 0 (low 24 bits) and plane 1 (top byte).
+    dirty: [Vec<u64>; 2],
+    stamp: u64,
+    /// `stamp` when the current context was last resolved.
+    seen: u64,
+    /// The frame and z buffer spans last marked dirty, their planes and the stamp then (the next prim on the same rows marks
+    /// nothing new).
+    marked: [((u32, u32), u8, u64); 2],
+    cache: HashMap<Key, Entry>,
+    names: Vec<Seen>,
+    by_name: HashMap<TexName, u32>,
+    dump: Option<Dumper>,
+    live: Option<Live>,
+    idp: Option<Box<[u32]>>,
+    pub(super) errors: Vec<String>,
+}
+
+impl TexHook {
+    /// Blocks `lo..hi` changed in `planes`: a new version, and dirty (a copy of drawn data) or clean (an upload).
+    fn bump(&mut self, (lo, hi): (u32, u32), dirty: bool, planes: u8) {
+        self.stamp += 1;
+        for b in (lo as usize).min(BLOCKS)..(hi as usize).min(BLOCKS) {
+            self.ver[b] = self.stamp;
+            let (w, m) = (b / 64, 1u64 << (b % 64));
+            for k in 0..2 {
+                if planes >> k & 1 != 0 {
+                    if dirty {
+                        self.dirty[k][w] |= m;
+                    } else {
+                        self.dirty[k][w] &= !m;
+                    }
+                }
+            }
+        }
+    }
+
+    fn any_dirty(&self, (lo, hi): (u32, u32), planes: u8) -> bool {
+        (0..2).any(|k| planes >> k & 1 != 0 && ((lo as usize).min(BLOCKS)..(hi as usize).min(BLOCKS)).any(|b| self.dirty[k][b / 64] >> (b % 64) & 1 != 0))
+    }
+
+    fn max_ver(&self, (lo, hi): (u32, u32)) -> u64 {
+        self.ver[(lo as usize).min(BLOCKS)..(hi as usize).min(BLOCKS)].iter().copied().max().unwrap_or(0)
+    }
+
+    /// Marks a span drawn into (slot 0 frame buffer, 1 z buffer): its blocks are dirty from now on (stamp bumped only if one was
+    /// clean).
+    fn drawn(&mut self, slot: usize, s: (u32, u32), planes: u8) {
+        if self.marked[slot] == (s, planes, self.stamp) {
+            return;
+        }
+        let (lo, hi) = ((s.0 as usize).min(BLOCKS), (s.1 as usize).min(BLOCKS));
+        for k in 0..2 {
+            if planes >> k & 1 != 0 && (lo..hi).any(|b| self.dirty[k][b / 64] >> (b % 64) & 1 == 0) {
+                self.stamp += 1;
+                for b in lo..hi {
+                    self.dirty[k][b / 64] |= 1 << (b % 64);
+                }
+            }
+        }
+        self.marked[slot] = (s, planes, self.stamp);
+    }
+}
+
+impl Gs {
+    /// Turns the texture hook on (before the first GIF data: the copy of local memory starts as the GS's).
+    pub fn textures(&mut self, o: TexOpts) {
+        self.finish();
+        let idp = o.cover.then(|| vec![0u32; VRAM_SIZE / 2].into_boxed_slice());
+        let mut t = Box::new(TexHook {
+            shadow: self.vram.clone(),
+            trx: Trx::default(),
+            ver: vec![0; BLOCKS],
+            dirty: [vec![0; BLOCKS / 64], vec![0; BLOCKS / 64]],
+            stamp: 1,
+            seen: 0,
+            marked: [((0, 0), 0, 0); 2],
+            cache: HashMap::new(),
+            names: Vec::new(),
+            by_name: HashMap::new(),
+            dump: o.dump,
+            live: o.live,
+            idp,
+            errors: Vec::new(),
+        });
+        self.queue.idp = t.idp.as_mut().map_or(0, |p| p.as_mut_ptr() as usize);
+        self.tex = Some(t);
+    }
+
+    /// The names drawn so far (id = index + 1).
+    pub fn tex_names(&self) -> &[Seen] {
+        self.tex.as_ref().map_or(&[], |t| &t.names[..])
+    }
+
+    /// The replacement folder, if one is loaded.
+    pub fn tex_live(&self) -> Option<&Live> {
+        self.tex.as_ref().and_then(|t| t.live.as_ref())
+    }
+
+    pub fn tex_dumper(&self) -> Option<&Dumper> {
+        self.tex.as_ref().and_then(|t| t.dump.as_ref())
+    }
+
+    /// Problems met so far (dumps that could not be written).
+    pub fn tex_errors(&self) -> &[String] {
+        self.tex.as_ref().map_or(&[], |t| &t.errors[..])
+    }
+
+    /// The texture id of every pixel of the shown picture (one circuit on; None otherwise or with coverage off): width, height and
+    /// the ids in rows. Waits for the rasteriser.
+    pub fn cover_ids(&mut self, c: &Crtc) -> Option<(u32, u32, Vec<u32>)> {
+        let k = match (c.enabled(0), c.enabled(1)) {
+            (true, false) => 0,
+            (false, true) => 1,
+            _ => return None,
+        };
+        let psm = (c.dispfb[k] >> 15 & 0x1f) as u32;
+        let (fbp, fbw, dbx, dby, w, h) = c.shown()?;
+        self.finish();
+        let plane = self.tex.as_ref()?.idp.as_ref()?;
+        let l = luts();
+        let mut out = Vec::with_capacity((w * h) as usize);
+        for y in dby..dby + h {
+            for x in dbx..dbx + w {
+                let a = match psm {
+                    0x00 | 0x01 => a32(l, fbp, fbw, x, y),
+                    0x02 | 0x0a => a16(l, fbp, fbw, x, y),
+                    _ => return None,
+                };
+                out.push(plane[a >> 1]);
+            }
+        }
+        Some((w, h, out))
+    }
+
+    /// TRXDIR = host -> local: the transfer starts; its blocks change.
+    pub(super) fn tex_trx_start(&mut self) {
+        let (bb, pos, rr) = (self.r[0x50], self.r[0x51], self.r[0x52]);
+        if let Some(t) = self.tex.as_deref_mut() {
+            t.trx = Trx::default();
+            t.bump(super::trx_blocks(bb, pos, rr), false, planes(((bb >> 56) & 0x3f) as u32));
+        }
+    }
+
+    /// One quadword of host -> local data.
+    pub(super) fn tex_image(&mut self, q: u128) {
+        let (bb, pos, rr) = (self.r[0x50], self.r[0x51], self.r[0x52]);
+        if let Some(t) = self.tex.as_deref_mut() {
+            unsafe { put(t.shadow.as_mut_ptr(), bb, pos, rr, &mut t.trx, q) };
+        }
+    }
+
+    /// A local -> local copy: repeated on the copy of local memory; the destination is dirty when the source was.
+    pub(super) fn tex_copy(&mut self) {
+        let (bb, pos, rr) = (self.r[0x50], self.r[0x51], self.r[0x52]);
+        let Some(t) = self.tex.as_deref_mut() else { return };
+        let (rw, rh) = ((rr & 0xfff) as u32, ((rr >> 32) & 0xfff) as u32);
+        if rw == 0 || rh == 0 {
+            return;
+        }
+        let (sbp, sbw, spsm) = ((bb & 0x3fff) as u32, ((bb >> 16) & 0x3f) as u32, ((bb >> 24) & 0x3f) as u32);
+        let (sx, sy) = ((pos & 0x7ff) as u32, ((pos >> 16) & 0x7ff) as u32);
+        let src_dirty = t.any_dirty(span(spsm, sbp, sbw, sx, sy, rw, rh), planes(spsm));
+        unsafe { local_copy(t.shadow.as_mut_ptr(), bb, pos, rr) };
+        t.bump(super::trx_blocks(bb, pos, rr), src_dirty, planes(((bb >> 56) & 0x3f) as u32));
+    }
+
+    /// Local memory changed since the current context was resolved.
+    pub(super) fn tex_stale(&self) -> bool {
+        self.tex.as_ref().is_some_and(|t| t.seen != t.stamp)
+    }
+
+    /// A prim with a new context (`fresh`) or after local memory changed: its texture's id and replacement. Returns the context to
+    /// draw with.
+    pub(super) fn tex_resolve(&mut self, mut cx: Ctx, fresh: bool) -> Ctx {
+        let (texa, texclut) = (self.r[0x3b], self.r[0x1c]);
+        let Some(t) = self.tex.as_deref_mut() else { return cx };
+        if !fresh && t.seen == t.stamp {
+            return cx;
+        }
+        t.seen = t.stamp;
+        (cx.tid, cx.repl, cx.repl_rect) = (0, 0, [0; 4]);
+        if !cx.tme || cx.ovl {
+            return cx;
+        }
+        let key = (cx.tex0 & TEX0_MASK, cx.clamp & ((1u64 << 44) - 1), texa, texclut);
+        if let Some(e) = t.cache.get(&key) {
+            if t.max_ver(e.span) <= e.built && t.max_ver(e.cspan) <= e.built && !t.any_dirty(e.span, planes(cx.tpsm)) && !t.any_dirty(e.cspan, 3) {
+                (cx.tid, cx.repl, cx.repl_rect) = (e.tid, e.repl, e.rect);
+                return cx;
+            }
+        }
+        let tex_span = span(cx.tpsm, cx.tbp, cx.tbw, 0, 0, cx.tw, cx.th);
+        let cbp = ((cx.tex0 >> 37) & 0x3fff) as u32;
+        let cspan = if gsname::has_palette(cx.tpsm) { (cbp, cbp + 4) } else { (0, 0) };
+        let mut e = Entry { built: t.stamp, span: tex_span, cspan, tid: 0, repl: 0, rect: [0; 4] };
+        // A texture at its own frame buffer's base in a plane the prim writes is feedback (the prim's own rows are marked after it).
+        let feedback = cx.tbp == cx.fbp && planes(cx.tpsm) & fb_planes(cx.fpsm, cx.fbmsk) != 0;
+        if feedback || t.any_dirty(tex_span, planes(cx.tpsm)) || t.any_dirty(cspan, 3) {
+            e.tid = RT;
+        } else if let Some(n) = gsname::name_for_draw(&t.shadow, cx.tex0, cx.clamp, texa, texclut, false) {
+            let tid = match t.by_name.get(&n.name) {
+                Some(&id) => id,
+                None => {
+                    let stem = n.name.stem(n.palette);
+                    if let Some(d) = t.dump.as_mut() {
+                        if let Err(err) = d.dump(&stem, &t.shadow, cx.tex0, cx.clamp, texa, texclut) {
+                            t.errors.push(err);
+                        }
+                    }
+                    let repl = t.live.as_mut().and_then(|l| l.get(&n.name, n.palette, n.w, n.h));
+                    t.names.push(Seen { name: n.name, stem, psm: n.psm, w: n.w, h: n.h, prims: 0, repl });
+                    let id = t.names.len() as u32;
+                    t.by_name.insert(n.name, id);
+                    id
+                }
+            };
+            e.tid = tid;
+            e.rect = [n.x, n.y, n.w, n.h];
+            // Region repeat (CLAMP mode 3) keeps the original: the named rectangle is not what such a texture repeats.
+            if cx.wms != 3 && cx.wmt != 3 {
+                if let Some(r) = &t.names[tid as usize - 1].repl {
+                    e.repl = Arc::as_ptr(r) as usize;
+                }
+            }
+        }
+        (cx.tid, cx.repl, cx.repl_rect) = (e.tid, e.repl, e.rect);
+        t.cache.insert(key, e);
+        cx
+    }
+
+    /// The prim with pixel box `bb` is queued: it counts against its texture's name, and the page rows of its frame buffer (and z
+    /// buffer, when it writes one: the z planes are not in local memory here, so whatever the copy holds there is stale) it touches
+    /// are drawn into.
+    pub(super) fn tex_prim(&mut self, bb: [i16; 4]) {
+        let cx = self.cur;
+        let zbuf = self.r[0x4e + ((cx.at >> 9) & 1) as usize];
+        let Some(t) = self.tex.as_deref_mut() else { return };
+        if cx.tid != 0 && cx.tid != RT {
+            t.names[cx.tid as usize - 1].prims += 1;
+        }
+        let (y0, y1) = (bb[1].max(0) as u32, bb[3].max(0) as u32);
+        let rows = |base: u32, ph: u32| (base + (y0 / ph) * cx.fbw * 32, base + (y1 / ph + 1) * cx.fbw * 32);
+        t.drawn(0, rows(cx.fbp, if matches!(cx.fpsm, 0x02 | 0x0a) { 64 } else { 32 }), fb_planes(cx.fpsm, cx.fbmsk));
+        if cx.zwrite {
+            // ZBUF PSM 0 / 1 (Z32 / Z24): 32-row pages; 2 / 10 (Z16 / Z16S): 64.
+            let zpsm = (zbuf >> 24) as u32 & 0xf;
+            t.drawn(1, rows((zbuf & 0x1ff) as u32 * 32, if zpsm & 2 != 0 { 64 } else { 32 }), planes(0x30 | zpsm));
+        }
+    }
+}
diff --git a/rac-rs/src/engine/gsfull/gs_queue.rs b/rac-rs/src/engine/gsfull/gs_queue.rs
index 2ed08d0..a796f29 100644
--- a/rac-rs/src/engine/gsfull/gs_queue.rs
+++ b/rac-rs/src/engine/gsfull/gs_queue.rs
@@ -20,7 +20,7 @@
 //! - a CLUT load identical to the last one emitted, with no write to its source since, is dropped (the CLUT
