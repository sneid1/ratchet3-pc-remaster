+	for y in 0..h {
+		for x in 0..w {
+			let p = texel(v, l, &t, (rl + x) as u32, (rt + y) as u32, texa);
+			let c = clut.as_ref().map_or(p, |c| c[p as usize & (c.len() - 1)]);
+			out.extend_from_slice(&c.to_le_bytes());
+		}
+	}
+	Some((w as u32, h as u32, out))
