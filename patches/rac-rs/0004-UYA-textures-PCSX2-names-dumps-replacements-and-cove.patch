@@ -0,0 +1,274 @@
+//! [PC] Texture packs for a game drawn by the GS-full pipe (Up Your Arsenal's port, `port/uya`): the PCSX2 texture names of what
+//! the game draws, dumps of those textures under the names PCSX2 gives them, and the replacement images of a plain PCSX2 folder.
+//!
+//! - Names: the GS front end (`gsfull/gs/texhook.rs`) names every texture a prim samples with `gsname::name_for_draw`, from its own
+//!   copy of local memory, so naming never waits for the rasteriser.
+//! - Dumps (`Dumper`): one `<stem>.png` per name, RGBA as PCSX2's `DumpTexture` writes it: the named rectangle (the clamp region when
+//!   there is one), palette applied, alpha on the GS scale (0x80 = opaque). An existing file is never overwritten.
+//! - Replacements (`Live`): every png / dds file under one folder whose name parses (`index::PackIndex`, PCSX2's rules), decoded on
+//!   first use into a `Repl`: a mip chain of RGBA8 with the file's alpha (GS scale, as PCSX2 packs store it). A renderer maps texel
+//!   (u, v) of the named rectangle at (x, y, w, h) to level texel ((u - x) * level.w / w, (v - y) * level.h / h). The software GS
+//!   samples it in `gs_raster::sample_repl`; a GPU renderer uploads `levels` as one texture with the same mapping.
+//! - Validation: a file that does not decode, is empty or larger than `MAX_SIDE`, has another aspect ratio than the rectangle it
+//!   replaces, is smaller than it, or does not fit the memory budget is refused with its reason (`Live::outcomes`); the game then
+//!   draws the original.
+
+use super::dds::Fmt;
+use super::index::{PackFile, PackIndex};
+use super::name::TexName;
+use super::chain::{Mip, ReplTex};
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+
+/// Largest side of a replacement file in texels.
+pub const MAX_SIDE: u32 = 8192;
+
+/// One level of a replacement: RGBA8, straight alpha on the GS scale (0x80 = opaque).
+pub struct Level {
+	pub w: u32,
+	pub h: u32,
+	pub rgba: Vec<u8>,
+}
+
+/// A decoded replacement.
+pub struct Repl {
+	pub name: TexName,
+	pub file: PathBuf,
+	/// Size of the file's image.
+	pub file_w: u32,
+	pub file_h: u32,
+	/// Level 0 is the largest level kept (`Live::new`'s `max_scale`), then each half the size down to 1 x 1.
+	pub levels: Vec<Level>,
+}
+
+impl Repl {
+	pub fn bytes(&self) -> usize {
+		self.levels.iter().map(|l| l.rgba.len()).sum()
+	}
+}
+
+/// What became of a name the game drew that the folder has a file for.
+#[derive(Clone, Debug)]
+pub struct Outcome {
+	pub stem: String,
+	pub file: PathBuf,
+	/// "ok", or why the file was refused.
+	pub state: String,
+	/// The file's size and the size of the rectangle it replaces.
+	pub file_size: (u32, u32),
+	pub rect_size: (u32, u32),
+}
+
+/// The replacement folder: its index and the images decoded so far.
+pub struct Live {
+	pub dir: PathBuf,
+	index: PackIndex,
+	/// Name -> the decoded image (None: refused).
+	cache: HashMap<TexName, Option<Arc<Repl>>>,
+	outcomes: Vec<Outcome>,
+	/// Levels larger than this many texels per original texel are not kept (None: keep the file's full size).
+	max_scale: Option<f32>,
+	budget: usize,
+	used: usize,
+}
+
+impl Live {
+	/// Indexes every replacement file under `dir` (recursively). `max_scale`: the largest scale over the original texture the kept
+	/// chain starts at (the software GS draws at the original resolution: 2 is enough there); `budget`: bytes of decoded chains.
+	pub fn new(dir: &Path, max_scale: Option<f32>, budget: usize) -> Result<Live, String> {
+		if !dir.is_dir() {
+			return Err(format!("texture replacements: {} is not a folder", dir.display()));
+		}
+		let mut index = PackIndex::new();
+		let st = index.scan_dir(dir, 0);
+		eprintln!("textures: {} replacement names in {} ({} duplicates, {} mip dumps skipped, {} other files)", st.added, dir.display(), st.duplicates, st.mip_dumps, st.other);
+		Ok(Live { dir: dir.to_path_buf(), index, cache: HashMap::new(), outcomes: Vec::new(), max_scale, budget, used: 0 })
+	}
+
+	pub fn len(&self) -> usize {
+		self.index.len()
+	}
+
+	pub fn is_empty(&self) -> bool {
+		self.index.is_empty()
+	}
+
+	/// The pack file for a name, if the folder has one.
+	pub fn file(&self, name: &TexName) -> Option<&PackFile> {
+		self.index.get(name)
+	}
+
+	/// The replacement of `name`, whose original is a `rect_w` x `rect_h` rectangle; decoded and checked on the first call.
+	pub fn get(&mut self, name: &TexName, palette: bool, rect_w: u32, rect_h: u32) -> Option<Arc<Repl>> {
+		if let Some(r) = self.cache.get(name) {
+			return r.clone();
+		}
+		let file = self.index.get(name)?.clone();
+		let res = self.load(name, &file, rect_w, rect_h);
+		let (state, file_size, repl) = match res {
+			Ok(r) => ("ok".to_string(), (r.file_w, r.file_h), Some(Arc::new(r))),
+			Err((why, size)) => (why, size, None),
+		};
+		if state != "ok" {
+			eprintln!("textures: {} refused: {state}", file.path.display());
+		}
+		self.outcomes.push(Outcome { stem: name.stem(palette), file: file.path.clone(), state, file_size, rect_size: (rect_w, rect_h) });
+		self.cache.insert(*name, repl.clone());
+		repl
+	}
+
+	fn load(&mut self, name: &TexName, f: &PackFile, rw: u32, rh: u32) -> Result<Repl, (String, (u32, u32))> {
+		let img = super::repl::load_file(f).map_err(|e| (format!("does not decode: {e}"), (0, 0)))?;
+		let (w, h) = (img.w, img.h);
+		if w == 0 || h == 0 || w > MAX_SIDE || h > MAX_SIDE {
+			return Err((format!("{w}x{h} is outside 1..{MAX_SIDE}"), (w, h)));
+		}
+		if u64::from(w) * u64::from(rh) != u64::from(h) * u64::from(rw) {
+			return Err((format!("aspect {w}x{h} differs from the original's {rw}x{rh}"), (w, h)));
+		}
+		if w < rw {
+			return Err((format!("{w}x{h} is smaller than the original {rw}x{rh}"), (w, h)));
+		}
+		let data = img.levels.into_iter().next().ok_or_else(|| ("no pixel data".to_string(), (w, h)))?;
+		let rgba = ReplTex { fmt: img.fmt, mips: vec![Mip { w, h, data }] }.to_rgba8().map_err(|e| (format!("does not decode: {e}"), (w, h)))?;
+		let mut top = rgba.mips.into_iter().next().ok_or_else(|| ("no pixel data".to_string(), (w, h)))?;
+		if top.data.len() != w as usize * h as usize * 4 {
+			return Err((format!("{} bytes for {w}x{h}", top.data.len()), (w, h)));
+		}
+		// The decoders give the engine's alpha scale (min(2a, 255), `dds::engine_alpha`); the GS scale is what the file holds.
+		top.data.chunks_exact_mut(4).for_each(|p| p[3] = (u32::from(p[3]) * 128 / 255) as u8);
+		let mut levels = vec![Level { w, h, rgba: top.data }];
+		while levels.last().is_some_and(|l| l.w > 1 || l.h > 1) {
+			let next = half(levels.last().unwrap());
+			levels.push(next);
+		}
+		if let Some(m) = self.max_scale {
+			// Drop the levels above the largest scale wanted (keep at least one).
+			let keep_from = levels.iter().position(|l| l.w as f32 <= m * rw as f32).unwrap_or(levels.len() - 1);
+			levels.drain(..keep_from);
+		}
+		let r = Repl { name: *name, file: f.path.clone(), file_w: w, file_h: h, levels };
+		if self.used + r.bytes() > self.budget {
+			return Err((format!("over the {} MB budget of decoded replacements", self.budget >> 20), (w, h)));
+		}
+		self.used += r.bytes();
+		Ok(r)
+	}
+
+	/// Every replacement looked up so far, in order of first use.
+	pub fn outcomes(&self) -> &[Outcome] {
+		&self.outcomes
+	}
+
+	/// Bytes of decoded chains held.
+	pub fn used(&self) -> usize {
+		self.used
+	}
+
+	/// The kind of image the file holds (dds format, or RGBA8 for png), without decoding it.
+	pub fn peek(f: &PackFile) -> Option<(u32, u32, Fmt)> {
+		super::repl::peek_file(f)
+	}
+}
+
+/// Half the size (each side rounded up), each texel the mean of the 2 x 2 (fewer at an odd edge) below it.
+fn half(l: &Level) -> Level {
+	let (w, h) = (l.w.div_ceil(2), l.h.div_ceil(2));
+	let mut rgba = Vec::with_capacity((w * h * 4) as usize);
+	for y in 0..h {
+		for x in 0..w {
+			let mut sum = [0u32; 4];
+			let mut n = 0;
+			for (sx, sy) in [(2 * x, 2 * y), (2 * x + 1, 2 * y), (2 * x, 2 * y + 1), (2 * x + 1, 2 * y + 1)] {
+				if sx < l.w && sy < l.h {
+					let o = ((sy * l.w + sx) * 4) as usize;
+					for k in 0..4 {
+						sum[k] += u32::from(l.rgba[o + k]);
+					}
+					n += 1;
+				}
+			}
+			rgba.extend(sum.map(|s| ((s + n / 2) / n) as u8));
+		}
+	}
+	Level { w, h, rgba }
+}
+
+/// Writes each named texture once as `<dir>/<stem>.png`.
+pub struct Dumper {
+	pub dir: PathBuf,
+	pub written: usize,
+	pub kept: usize,
+}
+
+impl Dumper {
+	pub fn new(dir: &Path) -> Result<Dumper, String> {
+		std::fs::create_dir_all(dir).map_err(|e| format!("{}: {e}", dir.display()))?;
+		Ok(Dumper { dir: dir.to_path_buf(), written: 0, kept: 0 })
+	}
+
+	/// The texture of a draw (the 4 MB local memory `vram` and its registers), unless a file of that name exists already.
+	pub fn dump(&mut self, stem: &str, vram: &[u8], tex0: u64, clamp: u64, texa: u64, texclut: u64) -> Result<(), String> {
+		let path = self.dir.join(format!("{stem}.png"));
+		if path.exists() {
+			self.kept += 1;
+			return Ok(());
+		}
+		let (w, h, rgba) = super::gsname::rgba_for_draw(vram, tex0, clamp, texa, texclut).ok_or_else(|| format!("{stem}: not a texture format"))?;
+		std::fs::write(&path, png_rgba(w, h, &rgba)).map_err(|e| format!("{}: {e}", path.display()))?;
+		self.written += 1;
+		Ok(())
+	}
+}
+
+/// A PNG of RGBA8 pixels (colour type 6, stored deflate blocks).
+pub fn png_rgba(w: u32, h: u32, rgba: &[u8]) -> Vec<u8> {
+	let row = w as usize * 4;
+	let mut raw = Vec::with_capacity((row + 1) * h as usize);
+	for r in rgba.chunks_exact(row) {
+		raw.push(0);
+		raw.extend_from_slice(r);
+	}
+	let mut z = vec![0x78, 0x01];
+	let blocks: Vec<&[u8]> = raw.chunks(65535).collect();
+	for (i, b) in blocks.iter().enumerate() {
+		z.push((i + 1 == blocks.len()) as u8);
+		z.extend_from_slice(&(b.len() as u16).to_le_bytes());
+		z.extend_from_slice(&(!(b.len() as u16)).to_le_bytes());
+		z.extend_from_slice(b);
+	}
+	let (mut s1, mut s2) = (1u32, 0u32);
+	for &b in &raw {
+		s1 = (s1 + u32::from(b)) % 65521;
+		s2 = (s2 + s1) % 65521;
+	}
+	z.extend_from_slice(&((s2 << 16) | s1).to_be_bytes());
+	let mut out = b"\x89PNG\r\n\x1a\n".to_vec();
+	let mut chunk = |kind: &[u8], payload: &[u8]| {
+		out.extend_from_slice(&(payload.len() as u32).to_be_bytes());
+		let mut body = kind.to_vec();
+		body.extend_from_slice(payload);
+		out.extend_from_slice(&body);
+		out.extend_from_slice(&crc32(&body).to_be_bytes());
+	};
+	let mut ihdr = Vec::with_capacity(13);
+	ihdr.extend_from_slice(&w.to_be_bytes());
+	ihdr.extend_from_slice(&h.to_be_bytes());
+	ihdr.extend_from_slice(&[8, 6, 0, 0, 0]);
+	chunk(b"IHDR", &ihdr);
+	chunk(b"IDAT", &z);
+	chunk(b"IEND", &[]);
+	out
+}
+
+fn crc32(data: &[u8]) -> u32 {
+	let mut c = 0xffff_ffffu32;
+	for &b in data {
+		c ^= u32::from(b);
+		for _ in 0..8 {
+			c = if c & 1 != 0 { 0xedb8_8320 ^ (c >> 1) } else { c >> 1 };
+		}
+	}
+	!c
+}
