+    r3 = (word(L + 4) == 0x30000004 | rt << 21 | rt << 16 and word(L + 8) == 0x14000004 | rt << 21 and word(L + 12) == word(L + 24) == 0
+          and word(L + 16) == 0x8fa00000 | rt << 16 and word(L + 20) == 0x1000fffa | rt << 21)
+    return w >> 26 == 0x23 and rt != 0 and rs != rt and (r1 or r3)
 
