+# ---- Up Your Arsenal (rc3) ----
+# The disc boots SCUS_973.53, a loader whose .rodata holds the main program (rac3-decomp's boot_elf) as a WAD image at file offset
+# 0x7080: records {address, size, kind, entry} + bytes, copied to their addresses. The core (engine code and data, below
+# RC3_CORE_END) stays resident; every level carries its own copy of the rest (.lit .bss .data three vtbls .text, 7 records, from the
+# disc's level table at sector 1001), and the front end is the same kind of program (the boot payload's own copy, and "frontbin" from
+# the MISC wad, which the game loads after Quit Game). Pseudo-levels 100 / 101 are those two front ends.
+RC3_BOOT_OFFSET = 0x7080
+RC3_PAYLOAD_SHA1 = 'f0d7eba4c9500247be705a3055e0a19bfeb6f698'
+RC3_CORE_END = 0x1d5680
+RC3_FRONT_A, RC3_FRONT_B = 100, 101
+RC3_TOC = 1001
+RC3_LEVEL_SECTIONS = 7
+
+
+def rc3_records(raw, stop_at_padding=False):
+    """[(address, size, kind, bytes)] of a program in the disc's format (every record repeats the entry point; the list ends
+    where it changes)."""
+    out, p, ep = [], 0, None
+    while p + 16 <= len(raw):
+        dest, n, kind, e = struct.unpack_from('<4I', raw, p)
+        ep = e if ep is None else ep
+        if e != ep or (stop_at_padding and dest == 0 and n == 0):
+            break
+        out.append((dest, n, kind, raw[p + 16:p + 16 + n]))
+        p += 16 + n
+    return out, p
+
+
+def rc3_payload(d):
+    """The main program as the loader unpacks it (its records), checked against rac3-decomp's SHA-1 of it."""
+    lba, size = iso_find(d, 'SCUS_973.53')
+    payload = iso_wad_decompress(d.bytes(lba, size)[RC3_BOOT_OFFSET:])
+    import hashlib
+    if hashlib.sha1(payload).hexdigest() != RC3_PAYLOAD_SHA1:
+        sys.exit("SCUS_973.53: boot payload SHA-1 is not the retail disc's")
+    recs, used = rc3_records(payload)
+    assert used == len(payload), (used, len(payload))
+    return recs
+
+
+def rc3_level_program(d, number):
+    """The records of level `number`'s program (tools/levels.py of rac3-decomp: the level table follows the global WAD headers of
+    the table of contents; each entry holds three (sector, size) pairs, the LEVEL one has a 0x60-byte header)."""
+    toc = d.bytes(RC3_TOC, 0x100000)
+    ofs = 0
+    while True:
+        size = struct.unpack_from('<i', toc, ofs)[0]
+        if size < 8 or size > 0xffff:
+            break
+        ofs += size
+    for i in range(128):
+        entry = struct.unpack_from('<6i', toc, ofs + 24 * i)
+        for lba in entry[0::2]:
+            at = (lba - RC3_TOC) * ISO_SEC
+            if lba <= RC3_TOC or at + 0x60 > len(toc):
+                continue
+            size, file_lba, num, _, data_sectors, _ = struct.unpack_from('<6i', toc, at)
+            if size != 0x60 or num != number:
+                continue
+            base = file_lba + data_sectors
+            prog_ofs, prog_size = struct.unpack('<ii', d.bytes(base, 8))
+            recs, used = rc3_records(d.bytes(base, prog_ofs + prog_size)[prog_ofs:])
+            assert used == prog_size and len(recs) == RC3_LEVEL_SECTIONS, (number, used, prog_size, len(recs))
+            return recs
+    sys.exit(f"level {number}: not in the disc's level table")
+
+
+def rc3_frontbin(d):
+    """The records of frontbin, the front end the game reloads after Quit Game (the MISC wad's global header, size 0x48 at
+    table-of-contents offset 0x648; its frontend_code range at +0x20)."""
+    toc = d.bytes(RC3_TOC, 0x1000)
+    size, sector = struct.unpack_from('<ii', toc, 0x648)
+    assert size == 0x48, size
+    fofs, fsize = struct.unpack_from('<ii', toc, 0x648 + 0x20)
+    recs, used = rc3_records(d.sectors(sector + fofs, fsize), stop_at_padding=True)
+    assert len(recs) == RC3_LEVEL_SECTIONS, len(recs)
+    return recs
+
+
+def rc3_build_image(d, lvl, size=0x2000000):
+    """Fresh-RAM image: the core records, then level `lvl`'s records (0: the core alone; RC3_FRONT_A: the boot payload as the
+    loader leaves it, its own front end included; RC3_FRONT_B: the core plus frontbin)."""
+    ram = bytearray(size)
+    for a, n, kind, b in rc3_payload(d):
+        if lvl == RC3_FRONT_A or a < RC3_CORE_END:
+            ram[a:a + len(b)] = b
+    extra = rc3_frontbin(d) if lvl == RC3_FRONT_B else rc3_level_program(d, lvl) if lvl not in (0, RC3_FRONT_A) else []
+    for a, n, kind, b in extra:
+        ram[a:a + len(b)] = b
+    return ram
+
+
 def iso_front_window(d):
     """The front end's text: the frontbin record that holds the overlay entry point (all other records are data), widened up
     to the boot ELF's end for the boot copy of the same code. Returns (lo, hi_frontbin, hi_boot_elf)."""
