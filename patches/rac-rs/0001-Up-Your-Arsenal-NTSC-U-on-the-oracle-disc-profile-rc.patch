diff --git a/oracle/src/rc3/cold_hooks.txt b/oracle/src/rc3/cold_hooks.txt
new file mode 100644
index 0000000..cd5730e
--- /dev/null
+++ b/oracle/src/rc3/cold_hooks.txt
@@ -0,0 +1,19 @@
+# UYA (SCUS_973.53) cold-boot hooks; the R&C2 rule each one replaces is named (oracle/src/rc2/cold_hooks.txt).
+# libkernel InitSys (0x124b90): its FindAddress scan of the BIOS image in RAM (syscall 0x83 over 0x80000000..0x80080000,
+# then SetSyscall) (R&C2 11f718) -> skip
+ret 124a80 0
+# sceSifInitRpc (0x121fe8: rac3-decomp's inventory splits its first instruction off as a 4-byte function) / sceSifInitCmd wait
+# for the IOP's reply packet over SIF0 (R&C2 11cf78 / 11c8d8) -> skip
+ret 121fe8 0
+ret 1218b8 0
+# sceSifRebootIop (sends the reset command with SifSetDma) / sceSifSyncIop (SMFLAG & 0x40000) (R&C2 11eed8 / 11eea0): the IOP
+# "rebooted" at once
+ret 124138 1
+ret 1242b8 1
+# WaitSema / PollSema / iPollSema syscall wrappers (syscalls 0x44, 0x45, -0x46; R&C2 11ac60/70/80): always succeed, through
+# `jr ra; move v0,a0` placed in free low RAM when the main program's crt0 entry (0x13ada8) runs.
+w32 13ada8 1000 03e00008
+w32 13ada8 1004 0080102d
+jmp 11ee60 1000
+jmp 11ee70 1000
+jmp 11ee80 1000
diff --git a/oracle/src/rc3/hle.rs b/oracle/src/rc3/hle.rs
new file mode 100644
index 0000000..5a7950a
--- /dev/null
+++ b/oracle/src/rc3/hle.rs
@@ -0,0 +1,232 @@
+//! UYA's IOP services (the IOP is not emulated; each reply is what the game reads back), reached from hle.rs `rpc_answer`
+//! (`rpc_rc3`) while `ver::rc3()`. A call to a server this file does not answer stops the machine with the call's
+//! details, so every service the game needs is seen and answered explicitly.
+use crate::cpu::Cpu;
+
+/// IOP RAM handed out by sceSifAllocSysMemory: a bump pointer over the 2 MB the oracle models (`Cpu::iop`), from 1 MB up
+/// (the lower part is the IOP kernel and modules on a real console).
+static IOP_HEAP_NEXT: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0x10_0000);
+const IOP_RAM_END: u32 = 0x20_0000;
+
+impl Cpu {
+    /// A UYA RPC call's reply (hle.rs `rpc_answer`).
+    #[allow(clippy::too_many_arguments)]
+    pub(crate) fn rpc_rc3(&mut self, client: u32, fno: u32, send: u32, ssize: u32, recv: u32, rsize: u32, end: u32, end_param: u32) {
+        let sid = self.note_call(client, fno, send, ssize, recv, rsize, end);
+        // The memory card server (mc.rs, with rc3::MC), then the save file, as R&C2 does.
+        if self.mem.rd32(client + 0x24) == crate::mc::MCSERV {
+            self.mc_rpc(fno, send, recv, end, end_param);
+            crate::mc::persist_after(self, fno);
+            return;
+        }
+        match (sid, fno) {
+            // libcdvd init server, sceCdInit (0x12b300): reply {?, cdvdfsv version, ?, mode} read uncached at recv + 4..0xc.
+            // All zero passes its version check (0x12b4f8: (0 + 0xff) >> 8 < 2) onto the success path, as R&C2's zero reply did.
+            (0x8000_0592, 0) => {
+                self.zero_reply(recv, rsize);
+                return;
+            }
+            // libcdvd disk-ready server, sceCdDiskReady(mode) (0x12b800): returns the reply word (read uncached at 0x12b9e0);
+            // its own failure value is 6, SCECdNotReady. The disc image is always in: 2, SCECdComplete.
+            (0x8000_059c, 0) => {
+                self.mem.wr32(recv, 2);
+                return;
+            }
+            // libcdvd S-command server (sid 0x80000593; the generic S-command call 0x12bd80 returns the reply word read
+            // uncached): fno 0x22 is sceCdMmode(media), the game sends 2 (SCECdDVD). 1 = done.
+            (0x8000_0593, 0x22) => {
+                self.mem.wr32(recv, 1);
+                return;
+            }
+            // fno 1 is sceCdReadClock (called from 0x12be84, reply 0x10 bytes): with the host clock on (clock.rs), word 0 = 1
+            // (done) and the console's RTC in JST at recv + 4, as R&C1's HLE answers it; with the fixed clock of tests and
+            // replays, the zeroed reply.
+            (0x8000_0593, 1) => {
+                self.zero_reply(recv, rsize);
+                if crate::clock::real() {
+                    self.mem.wr32(recv, 1);
+                    for (k, b) in crate::clock::rtc_now().iter().enumerate() {
+                        self.mem.wr8(recv + 4 + k as u32, *b);
+                    }
+                }
+                return;
+            }
+            // fno 4 is sceCdGetError (called from 0x12bc54): 0, no error (as R&C1's HLE answers it).
+            (0x8000_0593, 4) => {
+                self.mem.wr32(recv, 0);
+                return;
+            }
+            // libcdvd N-command server (sid 0x80000595, client 0x140ad0): fno 14 is sceCdGetDiskType, 0x14 = SCECdPS2DVD (as
+            // R&C1 and R&C2 answer it).
+            (0x8000_0595, 14) => {
+                self.mem.wr32(recv, 0x14);
+                return;
+            }
+            // fno 1 is sceCdRead {lba, sectors, buf, ..}: the read completes at once and the end callback's effects are
+            // applied (super::CD_*), as R&C1's and R&C2's HLE do. Every byte lands in `buf` directly, so the callback's
+            // copy of an unaligned buffer's head and tail (0x12ab88, from the IOP's bounce struct) has nothing to add.
+            // IOP heap server (sid 0x80000003, client 0x156400): fno 4 is sceSifAllocSysMemory(type, size, addr), which
+            // 0x123b98 sends as {size, type, addr} and returns the reply word: the block's IOP address, 0 = failed. Type 2
+            // asks for `addr` itself; 0 and 1 (first or last fit) get the next free block.
+            (0x8000_0003, 4) => {
+                let (size, kind, at) = (self.mem.rd32(send), self.mem.rd32(send + 4), self.mem.rd32(send + 8));
+                let addr = if kind == 2 {
+                    at
+                } else {
+                    let a = IOP_HEAP_NEXT.load(std::sync::atomic::Ordering::Relaxed);
+                    let end = a + ((size + 0xff) & !0xff);
+                    if end > IOP_RAM_END {
+                        self.stop = Some(format!("sceSifAllocSysMemory: {size:#x} bytes do not fit in IOP RAM (next free {a:#x})"));
+                        return;
+                    }
+                    IOP_HEAP_NEXT.store(end, std::sync::atomic::Ordering::Relaxed);
+                    a
+                };
+                if std::env::var("ORACLE_RPC").is_ok() {
+                    eprintln!("sceSifAllocSysMemory type {kind} size {size:#x} addr {at:#x} -> {addr:#x}");
+                }
+                self.mem.wr32(recv, addr);
+                return;
+            }
+            // fno 6 / 7 (0x123c20 / 0x123c90, no arguments, the reply word or -1 on failure): the free IOP memory in all and
+            // its largest block, sceSifQueryTotalFreeMemSize / sceSifQueryMaxFreeMemSize. The bump region is one block.
+            (0x8000_0003, 6 | 7) => {
+                let free = IOP_RAM_END - IOP_HEAP_NEXT.load(std::sync::atomic::Ordering::Relaxed);
+                self.mem.wr32(recv, free);
+                return;
+            }
+            // loadfile server (sid 0x80000006, client 0x1567c0): fno 0xff is its version query (0x123d60), whose 4 bytes the
+            // caller copies to 0x1567e8. No code of the main program reads that word back: zero.
+            (0x8000_0006, 0xff) => {
+                self.zero_reply(recv, rsize);
+                return;
+            }
+            // IOP file I/O server (sid 0x80000001, client 0x156300): fno 0xff is its init (0x1232a0, sends two EE buffers). Of
+            // the 8-byte reply, word 0 is stored at 0x156328, which no code of the main program reads, and word 1 == 2 sets
+            // 0x13dc88, which only steers the SIF command handler 0x122cc8 that the IOP would call (never, here): zero.
+            (0x8000_0001, 0xff) => {
+                self.zero_reply(recv, rsize);
+                return;
+            }
+            (0x8000_0595, 1) => {
+                use super::{CD_BUSY, CD_CMD, CD_RESULT};
+                let (lba, n, buf) = (self.mem.rd32(send), self.mem.rd32(send + 4), self.mem.rd32(send + 8));
+                if std::env::var("ORACLE_RPC").is_ok() {
+                    eprintln!("sceCdRead lba {lba:#x} sectors {n} buf {buf:#x} ra {:08x} icount {}", self.g(31) as u32, self.icount);
+                }
+                if !self.iso_read(lba, n, buf & 0x01ff_ffff) {
+                    self.stop = Some(format!("sceCdRead lba {lba:#x} sectors {n}: outside the disc image"));
+                    return;
+                }
+                let cmd = self.mem.rd32(CD_CMD);
+                self.mem.wr32(CD_RESULT, cmd);
+                self.mem.wr32(CD_BUSY, 0);
+                self.mem.wr32(CD_CMD, 0);
+                return;
+            }
+            // libmtap's mtapman.irx (sid 0x80000900, client 0x15ba00; strings at 0x151a10..): every call sends and receives the
+            // 128-byte buffer 0x15ba40. fno 5 sceMtapGetModVersion: word 0 = the module version, which libmtap.a 3.16 requires
+            // to be 3.16 (0x12eab4: version >> 4 == 0x31). fno 1 sceMtapPortOpen(port): word 1 = 1, opened. fno 3
+            // sceMtapGetConnection(port): word 1 = 0, no multitap in the port (one controller, plugged in directly).
+            (0x8000_0900, 5) => {
+                self.zero_reply(recv, rsize);
+                self.mem.wr32(recv, 0x310);
+                return;
+            }
+            (0x8000_0900, 1) => {
+                self.mem.wr32(recv + 4, 1);
+                return;
+            }
+            (0x8000_0900, 3) => {
+                self.mem.wr32(recv + 4, 0);
+                return;
+            }
+            // fno 6 (0x12e9d8, right after the version check): gives mtapman an EE buffer (0x15bac0, zeroed just before) for
+            // its status; the init ignores the reply. Without a multitap the module never writes it: word 0 = 0.
+            (0x8000_0900, 6) => {
+                self.mem.wr32(recv, 0);
+                return;
+            }
+            // libpad's padman.irx (sids 0x80000100 / 0x80000101, clients 0x15bb40 / 0x15bb68; strings at 0x151b31..): fno 1
+            // with a 128-byte buffer whose word 0 is the command; the reply comes back in the same buffer.
+            (0x8000_0100 | 0x8000_0101, 1) => {
+                let cmd = self.mem.rd32(send);
+                match cmd {
+                    // Module version (0x12fce8 returns word 3): libpad.a 4.0 requires major 4 (0x12ed6c: version >> 8 == 4).
+                    0x12 => self.mem.wr32(recv + 0xc, 0x400),
+                    // Init (0x12ee18, with libpad's buffer at word 5) and end (0x12ef10): word 3 is the result, 1 = done.
+                    0x10 | 0xf => self.mem.wr32(recv + 0xc, 1),
+                    // scePadSetMainMode (0x12f860) and scePadSetActAlign (0x12f9e0): word 5 = 1, accepted. The frames padman
+                    // DMAs (pad.rs) already show the analog mode, and their request state stays 0, complete.
+                    6 | 8 => self.mem.wr32(recv + 0x14, 1),
+                    // Button info, the pressure-sensitive buttons on (0x12fb68): word 4 = 1, accepted.
+                    0xa => self.mem.wr32(recv + 0x10, 1),
+                    // Command 24 (0x12fd50, word 1 = 0 or 1): the caller reads no reply word, only whether the call went out.
+                    0x18 => {}
+                    // scePadPortOpen {1, port, slot, -, EE DMA buffer} (0x12f1c0): word 3 = 1, opened; word 5 = padman's area
+                    // for that port and slot in IOP RAM, which libpad keeps (0x12f23c). One 0x100 block per port and slot at
+                    // 0x3_0000, below the data cache (super::IOP_CACHE_BASE), in IOP RAM nothing else uses.
+                    1 => {
+                        let (port, slot) = (self.mem.rd32(send + 4), self.mem.rd32(send + 8));
+                        super::pad::opened(port, slot, self.mem.rd32(send + 0x10));
+                        self.mem.wr32(recv + 0xc, 1);
+                        self.mem.wr32(recv + 0x14, 0x3_0000 + (port * 4 + slot) * 0x100);
+                    }
+                    _ => {
+                        if self.stop.is_none() {
+                            self.stop = Some(format!("rc3: padman command {cmd:#x} not answered (sid {sid:#x}, send {send:x}, ra {:08x})", self.g(31) as u32));
+                        }
+                    }
+                }
+                return;
+            }
+            // 989snd (super::SND_*): R&C2's command server and bank loader HLE, the same module and protocol.
+            (super::SND_LOAD_SID, 3 | 0x57) if send != 0 && recv != 0 => {
+                self.snd_bank_load(fno, send, recv, rsize);
+                return;
+            }
+            (super::SND_SID, _) => {
+                self.snd_rpc_rc2(fno, send, ssize, recv, rsize);
+                return;
+            }
+            // IOP data cache (super::IOP_CACHE_*): fno 2 = its buffer {base, size, ..}; fno 1 {iop addr} copies rsize bytes
+            // of IOP RAM back to recv (what the EE parked there with sceSifSetDma).
+            (super::IOP_CACHE_SID, 2) => {
+                self.zero_reply(recv, rsize);
+                self.mem.wr32(recv, super::IOP_CACHE_BASE);
+                self.mem.wr32(recv + 4, super::IOP_CACHE_SIZE);
+                return;
+            }
+            (super::IOP_CACHE_SID, 1) => {
+                let (src, n) = (self.mem.rd32(send) as usize & 0x1f_ffff, rsize as usize);
+                if src + n > IOP_RAM_END as usize {
+                    self.stop = Some(format!("IOP data cache read {src:#x}+{n:#x} past the 2 MB IOP RAM"));
+                    return;
+                }
+                if src + n > self.iop.len() {
+                    self.iop.resize(IOP_RAM_END as usize, 0);
+                }
+                for k in 0..n {
+                    self.mem.wr8(recv.wrapping_add(k as u32), self.iop[src + k]);
+                }
+                return;
+            }
+            _ => {}
+        }
+        let w0 = if send != 0 { self.mem.rd32(send) } else { 0 };
+        // The first unanswered call is the one to report: later calls in the same dispatch batch must not replace it.
+        if self.stop.is_some() {
+            return;
+        }
+        self.stop = Some(format!(
+            "rc3: no reply for RPC sid {sid:#x} fno {fno:#x} (client {client:x}, send {send:x} size {ssize:#x} w0 {w0:08x}, recv {recv:x} size {rsize:#x}, end {end:x}/{end_param:x}, ra {:08x})",
+            self.g(31) as u32
+        ));
+    }
+
+    fn zero_reply(&mut self, recv: u32, rsize: u32) {
+        for k in 0..rsize / 4 {
+            self.mem.wr32(recv + 4 * k, 0);
+        }
+    }
+}
diff --git a/oracle/src/rc3/mod.rs b/oracle/src/rc3/mod.rs
new file mode 100644
index 0000000..67dc599
--- /dev/null
+++ b/oracle/src/rc3/mod.rs
@@ -0,0 +1,63 @@
+//! Ratchet & Clank: Up Your Arsenal (NTSC-U SCUS_973.53, disc "RATCHETANDCLANK3", VER 1.00): the game profile of the oracle,
+//! used only while `ver::rc3()`. The disc boots a loader at 0x800000 (SCUS_973.53) that unpacks the main program
+//! (rac3-decomp's `boot_elf`, entry 0x13ada8) to 0x100000; every address here is in that main program. Found in the
+//! unpacked program (ratchet3-remaster scripts/uya_sdk_scan.py, function starts from rac3-decomp config/us/inventory.tsv):
+//! the libkernel syscall wrappers by their `addiu v1, zero, N; syscall` pairs, libsif by the RPC command ids it loads
+//! (0x8000_0009 bind, 0x8000_000a call) and the sceSifAddCmdHandler calls of sceSifInitRpc, the IOP servers by the sids
+//! their bind calls load. Children: `hle.rs` (UYA's IOP services).
+
+pub mod hle;
+pub mod movie;
+pub mod pad;
+
+/// UYA's host stubs on game functions, installed at the cold boot (cold.rs `boot`).
+pub fn install(c: &mut crate::cpu::Cpu) {
+    c.add_host_stub(movie::PLAYER, "movie player (rc3/movie.rs)", movie::PLAYER_SIG, movie::player);
+}
+
+/// The oracle's own hooks (ver::Addrs). sceSifBindRpc 0x122630 (loads 0x8000_0009 twice), sceSifCallRpc 0x122810 (loads
+/// 0x8000_000a twice). sceGsSyncV's INTC_STAT poll 0x11f390 (VBON, bit 2; `Cpu::poll_ff` skips it to the next vblank). The
+/// vblank wait of compiled code and the pad read are not located yet: 0xffff_fff0 is never a pc (as R&C2's poll head).
+pub const ADDRS: crate::ver::Addrs = crate::ver::Addrs { vblank_wait: 0xffff_fff0, poll_head: 0x11f390, pad_read: 0xffff_fff0, sif_call_rpc: 0x122810, sif_bind_rpc: 0x122630 };
+
+/// libcdvd N-command client (bound to sid 0x80000595) and the words the end callback of its calls leaves (0x12aae0, reached
+/// from sceCdRead's 0x12ab88): result 0x13f964 = command 0x13f960, busy word 0x13f934 cleared, then the command cleared
+/// (R&C2 0x1375d0 / 0x136454 / 0x136430 / 0x136458).
+pub const CD_NCMD_CLIENT: u32 = 0x140ad0;
+pub const CD_CMD: u32 = 0x13f960;
+pub const CD_BUSY: u32 = 0x13f934;
+pub const CD_RESULT: u32 = 0x13f964;
+
+/// libmc (client 0x15a400 bound to sid 0x80000400; call sites 0x12dbe4..0x12e95c, reply word 0x15b9c0): GetInfo end callback
+/// 0x12e3a8 and its three output pointers (R&C2 0x127c68); no Chdir call (no fno 0xc among the call sites); Read callback 0x12dfa0
+/// (head/tail layout as R&C1's); the send structs of 0x30 / 0x414 bytes; the other calls end in 0x12dc88, which only signals
+/// libmc's semaphore (iSignalSema of 0x141540).
+pub const MC: crate::mc::McAddrs = crate::mc::McAddrs {
+    cb_getinfo: 0x12e3a8,
+    getinfo_ptrs: [(0x15a428, 0), (0x15a42c, 4), (0x15a430, 0x90)],
+    cb_chdir: 0xffff_fff0,
+    chdir_dir: 0x0010_0000,
+    cb_read: 0x12dfa0,
+    send_30: 0x15a480,
+    send_414: 0x15a4b0,
+    cb_signal: 0x12dc88,
+};
+
+/// 989snd's command server (client 0x1d4900) and bank loader (client 0x1d49c0), the same module and sids as R&C2's, answered by
+/// R&C2's HLE (rc2/hle.rs `snd_rpc_rc2`, `snd_bank_load`). Its CD channel read (0x13cd20: busy word 0x1d4980 = 1, status word
+/// +0x10 = 0, then command 56 {lba, sectors, buf}; 0x13cdf0 polls the busy word) is done at the next field tick, when
+/// `snd_cd_finish` clears both words (R&C2 0x1a7180).
+pub const SND_SID: u32 = 0x123456;
+pub const SND_LOAD_SID: u32 = 0x123457;
+pub const SND_CD_BUSY: u32 = 0x1d4980;
+
+/// IOP data cache module (sid 0x11, client 0x1d4b08, as R&C2's): the EE parks blobs in IOP RAM and copies them back (fno 1),
+/// inside the buffer fno 2 reports. Its region of the modelled 2 MB IOP RAM sits below the heap that sceSifAllocSysMemory hands
+/// out from 1 MB up (hle.rs), so the two never overlap.
+pub const IOP_CACHE_SID: u32 = 0x11;
+pub const IOP_CACHE_BASE: u32 = 0x4_0000;
+pub const IOP_CACHE_SIZE: u32 = 0xc_0000;
+
+/// Stub rules (oracle/stubs.txt format) and cold-boot hook rules (cold_hooks.txt format) of UYA.
+pub const STUBS: &str = include_str!("stubs.txt");
+pub const HOOKS: &str = include_str!("cold_hooks.txt");
diff --git a/oracle/src/rc3/movie.rs b/oracle/src/rc3/movie.rs
new file mode 100644
index 0000000..a4504d9
--- /dev/null
+++ b/oracle/src/rc3/movie.rs
@@ -0,0 +1,33 @@
+//! UYA's movie player (front end 0x3afaa8, called by the boot sequence 0x3a7ab0 and by 0x3a8f64): it allocates its buffers
+//! through its third argument, sets up libmpeg on the IPU (0x3917c0, 0x3affe8), runs the stream loop 0x3afc70 and returns
+//! that loop's result: 1 when Start ended the movie, 0 when it played to its end. On the way out it clears bit 0x80 of
+//! 0x1d4d40. The oracle has no IPU, so the loop would wait forever for decoded pictures (the decoder never reaches state 3).
+//! This host stub takes the player's place, as rac-rs's fmv_bridge does for R&C1's: a movie service (`set_service`, the
+//! window) plays the PSS and says whether Start ended it. With no service the movie cannot be watched, so it is skipped:
+//! 1, as when Start ends it. That is also what the front end's movie sequence 0x3a8d80 needs to leave for the title
+//! (0x392f68 stops the sequence on a skip, then 0x3a1258); a 0 would start the next attract movie at once, forever.
+use crate::cpu::Cpu;
+use std::sync::OnceLock;
+
+pub const PLAYER: u32 = 0x3afaa8;
+/// The player's first four code words (the front end's .text): the stub applies only while they are in RAM.
+pub const PLAYER_SIG: [u32; 4] = [0x27bd_ffc0, 0xffb5_0028, 0xffb6_0030, 0x0080_a82d];
+/// The flag word whose bit 0x80 the player clears on its way out (0x3afc28..0x3afc60).
+const FLAGS: u32 = 0x1d4d40;
+
+/// A movie service: called with the player's arguments (a0, a1, a3, t0), returns true when Start ended the movie.
+static SERVICE: OnceLock<fn(&mut Cpu, [u32; 4]) -> bool> = OnceLock::new();
+
+/// Attaches the movie service (the window that plays the PSS). Once per process.
+pub fn set_service(f: fn(&mut Cpu, [u32; 4]) -> bool) {
+    let _ = SERVICE.set(f);
+}
+
+pub fn player(c: &mut Cpu) -> bool {
+    let args = [c.g(4) as u32, c.g(5) as u32, c.g(7) as u32, c.g(8) as u32];
+    let skipped = SERVICE.get().is_none_or(|f| f(c, args));
+    let flags = c.mem.rd32(FLAGS);
+    c.mem.wr32(FLAGS, flags & !0x80);
+    c.s(2, skipped as u64);
+    true
+}
diff --git a/oracle/src/rc3/pad.rs b/oracle/src/rc3/pad.rs
new file mode 100644
index 0000000..3141e1d
--- /dev/null
+++ b/oracle/src/rc3/pad.rs
@@ -0,0 +1,66 @@
+//! padman's side of UYA's pads: every field the IOP pad driver DMAs a 0x80-byte frame into the EE buffer each open port
+//! and slot gave scePadPortOpen (word 4 of the open command, hle.rs), alternating between the buffer's two halves and
+//! counting up the frame number at +0x58. libpad's own code reads it (0x12f2a0 copies the half with the larger frame number;
+//! scePadGetState reads its state byte +0x70, scePadRead its data and length). Frame layout as libpad 4.0 reads it:
+//!   +0x00 data (32 bytes: 0 = ok, mode id, buttons (active low), right x/y, left x/y, 12 pressures), +0x50 mode table
+//!   (u16 x4), +0x58 frame number, +0x60 data length, +0x64 mode config, +0x65 current mode id, +0x66 model, +0x67 data ready,
+//!   +0x68 mode count, +0x69 current mode offset, +0x6a actuator count, +0x6b actuator combinations, +0x6d mode,
+//!   +0x6e mode lock, +0x70 state (6 = stable), +0x71 request state (0 = complete), +0x72 current task (1 = updating).
+//! Port 0 slot 0 is a DualShock 2 in analog mode with pressure (mode id 0x79: nine halfwords of data) whose buttons and
+//! sticks are `Cpu::pad` (`Machine::set_pad`); every other port and slot reports no pad (state 0).
+use crate::cpu::Cpu;
+use std::sync::Mutex;
+
+/// (port, slot, EE address of its 0x100-byte DMA buffer) of every open port.
+static OPEN: Mutex<Vec<(u32, u32, u32)>> = Mutex::new(Vec::new());
+
+/// scePadPortOpen(port, slot, buffer) reached padman (hle.rs).
+pub fn opened(port: u32, slot: u32, buf: u32) {
+    let mut o = OPEN.lock().unwrap();
+    o.retain(|&(p, s, _)| (p, s) != (port, slot));
+    o.push((port, slot, buf));
+}
+
+/// One field of padman: the next frame of every open port.
+pub fn field(c: &mut Cpu) {
+    let open = OPEN.lock().unwrap().clone();
+    for (port, slot, buf) in open {
+        // The older half gets the new frame, numbered one past the newer half's.
+        let (n0, n1) = (c.mem.rd32(buf + 0x58), c.mem.rd32(buf + 0x80 + 0x58));
+        let half = if n0 <= n1 { buf } else { buf + 0x80 };
+        let f = frame(c.pad.filter(|_| port == 0 && slot == 0), n0.max(n1).wrapping_add(1));
+        for (k, b) in f.iter().enumerate() {
+            c.mem.wr8(half + k as u32, *b);
+        }
+    }
+}
+
+fn frame(pad: Option<[u8; 18]>, number: u32) -> [u8; 0x80] {
+    let mut f = [0u8; 0x80];
+    f[0x58..0x5c].copy_from_slice(&number.to_le_bytes());
+    let Some(report) = pad else {
+        // No pad in this port: state 0, disconnected.
+        return f;
+    };
+    f[0] = 0;
+    f[1] = 0x79;
+    f[2..20].copy_from_slice(&report);
+    for (k, id) in [0x0004u16, 0x0007].iter().enumerate() {
+        f[0x50 + 2 * k..0x52 + 2 * k].copy_from_slice(&id.to_le_bytes());
+    }
+    f[0x60..0x64].copy_from_slice(&20u32.to_le_bytes());
+    f[0x64] = 1;
+    f[0x65] = 0x79;
+    f[0x66] = 3;
+    f[0x67] = 1;
+    f[0x68] = 2;
+    f[0x69] = 1;
+    f[0x6a] = 2;
+    f[0x6b] = 1;
+    f[0x6d] = 1;
+    f[0x6e] = 3;
+    f[0x70] = 6;
+    f[0x71] = 0;
+    f[0x72] = 1;
+    f
+}
