diff --git a/oracle/src/snd989/bank.rs b/oracle/src/snd989/bank.rs
index fd694f1..2bd3da6 100644
--- a/oracle/src/snd989/bank.rs
+++ b/oracle/src/snd989/bank.rs
@@ -186,11 +186,25 @@ impl Bank {
         let container = span(container, 0, len)?;
         let meta = span(container, u32le(container, 8)? as usize, u32le(container, 12)? as usize)?;
         let data = span(container, u32le(container, 16)? as usize, u32le(container, 20)? as usize)?;
-        if span(meta, 0, 4)? != b"SBlk" || u32le(meta, 4)? != 1 {
-            return Err("sound bank: not an SBlk version 1 block".into());
+        let version = u32le(meta, 4)?;
+        if span(meta, 0, 4)? != b"SBlk" || (version != 1 && version != 3) {
+            return Err("sound bank: not an SBlk version 1 or 3 block".into());
         }
         let signature = Signature::from_sblk(meta)?;
         let sound_table = u32le(meta, 0x1c)? as usize;
+        if version == 3 {
+            // Version 3 (Up Your Arsenal): the header counts, the sound table offset (+0x1c) and its 12-byte entries are
+            // version 1's, but a grain is an 8-byte record (each sound's grain offset steps by 8 per grain; the grain area
+            // ends at the offset in +0x34, where a parameter area begins) whose layout the model does not decode yet. The
+            // bank loads with its sample data and every sound entry, without grains: the model voices none of them, so a
+            // play returns no handle (`playable`).
+            let mut sounds = Vec::with_capacity(signature.sounds as usize);
+            for i in 0..signature.sounds as usize {
+                let e = span(meta, sound_table + i * SOUND_BYTES, SOUND_BYTES)?;
+                sounds.push(Sound { volume: e[0] as i8, group: e[1], pan: u16le(e, 2)?, pad5: e[5], flags: u16le(e, 6)?, grain_offset: u32le(e, 8)?, grains: Vec::new() });
+            }
+            return Ok(Bank { signature, sounds, data: data.to_vec() });
+        }
         let grain_table = u32le(meta, 0x20)? as usize;
         let grains = span(meta, grain_table, signature.grains as usize * GRAIN_BYTES)?;
         let mut sounds = Vec::with_capacity(signature.sounds as usize);
