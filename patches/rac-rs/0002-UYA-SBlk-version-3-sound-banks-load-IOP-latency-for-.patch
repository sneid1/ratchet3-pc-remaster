@@ -0,0 +1,72 @@
+//! IOP latency for 989snd's no-wait calls. On a PS2 a sceSifCallRpc in no-wait mode (mode bit 0) returns at once and the
+//! reply lands in EE memory a little later, when the IOP's server has run; until then sceSifCheckStatRpc says busy. The
+//! HLE computes the reply during the call, so this module holds it back: the reply buffer keeps what the EE left there
+//! (989snd's 0x13b8b0 clears the framing words) and the reply lands when the game asks sceSifCheckStatRpc after `LATENCY`
+//! instructions, or when the next call on the same client needs the buffer.
+//!
+//! UYA's 989snd needs this. After a no-wait direct command (the per-field command 8 from 0x13c660) the game's sound pass
+//! (0x13b620, from the level's 0x45ca90) runs the callbacks of the last batch again once it sees a finished reply. On a
+//! console the reply has not arrived yet at that point, so nothing runs twice; with instant replies the last batch's
+//! callbacks ran every field, and after the level replaced the front end the front end's callback 0x3bbb18 pointed into
+//! level code.
+use crate::cpu::Cpu;
+use std::sync::Mutex;
+
+/// sceSifCheckStatRpc(cd) and its first four code words (the host stub applies only while they are in RAM).
+pub const CHECK_STAT: u32 = 0x122a10;
+pub const CHECK_STAT_SIG: [u32; 4] = [0x8c85_0000, 0x10a0_0009, 0x0000_0000, 0x8c83_0004];
+/// EE instructions a no-wait reply takes to land: about 0.34 ms at 294.912 MHz, an IOP RPC round trip.
+pub const LATENCY: u64 = 100_000;
+
+struct Held {
+    client: u32,
+    recv: u32,
+    words: Vec<u32>,
+    due: u64,
+}
+
+static HELD: Mutex<Vec<Held>> = Mutex::new(Vec::new());
+
+/// The reply buffer's words before the HLE answers (what `hold` puts back).
+pub fn before(c: &mut Cpu, recv: u32, rsize: u32) -> Vec<u32> {
+    (0..rsize / 4).map(|k| c.mem.rd32(recv + 4 * k)).collect()
+}
+
+/// Holds back the reply the HLE just wrote at `recv`: the EE sees `before` there until the reply lands.
+pub fn hold(c: &mut Cpu, client: u32, recv: u32, before: Vec<u32>) {
+    let words: Vec<u32> = (0..before.len() as u32).map(|k| c.mem.rd32(recv + 4 * k)).collect();
+    for (k, w) in before.iter().enumerate() {
+        c.mem.wr32(recv + 4 * k as u32, *w);
+    }
+    HELD.lock().unwrap().push(Held { client, recv, words, due: c.icount + LATENCY });
+}
+
+/// Lands the held replies of `client` that are due (all of them with `now`); true while one is still on its way.
+pub fn land(c: &mut Cpu, client: u32, now: bool) -> bool {
+    let mut held = HELD.lock().unwrap();
+    let mut busy = false;
+    let icount = c.icount;
+    held.retain(|h| {
+        if h.client != client {
+            return true;
+        }
+        if now || icount >= h.due {
+            for (k, w) in h.words.iter().enumerate() {
+                c.mem.wr32(h.recv + 4 * k as u32, *w);
+            }
+            false
+        } else {
+            busy = true;
+            true
+        }
+    });
+    busy
+}
+
+/// Host stub on sceSifCheckStatRpc(cd): 1 while a reply of `cd` is on its way, else 0 (every other call completed at once).
+pub fn check_stat(c: &mut Cpu) -> bool {
+    let client = c.g(4) as u32;
+    let busy = land(c, client, false);
+    c.s(2, busy as u64);
+    true
+}
