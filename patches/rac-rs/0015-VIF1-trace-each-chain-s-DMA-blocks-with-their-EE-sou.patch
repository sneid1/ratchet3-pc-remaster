diff --git a/oracle/src/gs.rs b/oracle/src/gs.rs
index 27ea80a..f488b46 100644
--- a/oracle/src/gs.rs
+++ b/oracle/src/gs.rs
@@ -36,6 +36,38 @@ struct Tag {
 /// a consumer that never recycles only costs the old allocation. Contents are never read across kicks (len is reset to 0).
 static WORDS_POOL: std::sync::Mutex<Vec<Vec<u32>>> = std::sync::Mutex::new(Vec::new());
 
+/// VIF1 trace (a capture tool's one field): while on, every VIF1 chain that goes to the GS capture records its DMA blocks, in kick
+/// order: (word index of the block's first data word in the job's stream, EE source address, qwords, DMA tag id; 99 = a normal
+/// transfer from MADR). `trace_take` returns them and turns the trace off.
+pub static VIF1_TRACE: std::sync::Mutex<Option<Vec<Vec<(usize, u32, u32, u32)>>>> = std::sync::Mutex::new(None);
+static VIF1_TRACE_ON: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// Starts the VIF1 trace.
+pub fn trace_start() {
+    if let Ok(mut t) = VIF1_TRACE.lock() {
+        *t = Some(Vec::new());
+    }
+    VIF1_TRACE_ON.store(true, std::sync::atomic::Ordering::Relaxed);
+}
+
+/// Ends the VIF1 trace: the blocks of each chain since `trace_start`.
+pub fn trace_take() -> Vec<Vec<(usize, u32, u32, u32)>> {
+    VIF1_TRACE_ON.store(false, std::sync::atomic::Ordering::Relaxed);
+    VIF1_TRACE.lock().ok().and_then(|mut t| t.take()).unwrap_or_default()
+}
+
+pub(crate) fn trace_on() -> bool {
+    VIF1_TRACE_ON.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+pub(crate) fn trace_push(blocks: Vec<(usize, u32, u32, u32)>) {
+    if let Ok(mut t) = VIF1_TRACE.lock() {
+        if let Some(t) = t.as_mut() {
+            t.push(blocks);
+        }
+    }
+}
+
