+    let gl=nv*sqrt(nl*nl*(1.0-a2)+a2);
+    let visibility=0.5/max(gv+gl,0.00001);
+    let diffuse=(1.0-f)*(1.0-metal)*base/MATERIAL_PI;
+    return (diffuse+f*distribution*visibility)*max(radiance,vec3<f32>(0.0))*nl*MATERIAL_PI;
